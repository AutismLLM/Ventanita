# Copy this to .env (same directory), fill in your real key, never commit .env.
OPENAI_API_KEY=sk-proj-your-key-here

# Optional overrides — config.yaml's llm.provider/llm.model win if set there;
# these only apply when running modules standalone without a config.yaml.
VENTANITA_LLM_PROVIDER=openai
VENTANITA_LLM_MODEL=gpt-5.6-terra
